# agent-model-router reads keys from the environment only when a backend names them.
# Copy to .env (never commit it) or export in your shell.

# The local router token. If unset, one is created in ~/.config/agent-model-router/token.
# AGENT_ROUTER_TOKEN=amr-change-me

# Optional hosted backend (disabled in the default config). Your own key; never sent by tests.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Use a specific config file.
# AGENT_ROUTER_CONFIG=~/.config/agent-model-router/config.yaml
